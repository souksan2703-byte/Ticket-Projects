# SQL Server connection (จาก DBeaver ก็ใช้ค่าเดียวกันนี้ได้เลย)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=MMoneyDB
DB_USER=sa
DB_PASSWORD=your_password_here
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT สำหรับ auth (ใช้ตอนทำหน้า Sign in / Admin users)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# Server
PORT=5000
